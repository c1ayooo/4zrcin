{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "baseUrl": "./",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "paths": {
      "@/*": ["src/*"],
      "@cyber/ui": ["packages/ui/src/index.ts"],
      "@cyber/ui/*": ["packages/ui/src/*"],
      "@cyber/theme": ["packages/theme/src/index.ts"],
      "@cyber/theme/*": ["packages/theme/src/*"]
    }
  },
  "include": ["src"]
}
